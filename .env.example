# Admin password for /api/auth. Required.
ADMIN_TOKEN=

# Admin username. Optional, defaults to "admin".
ADMIN_USER=admin

# Your Firebase service account, as one line of JSON. Required.
# Firebase console -> Project settings -> Service accounts -> Generate new private key.
# Keep the "private_key" \n escapes exactly as they are.
FIREBASE_SERVICE_ACCOUNT=

# Instead of FIREBASE_SERVICE_ACCOUNT you may set these three separately:
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
