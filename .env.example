# The original admin password, used until you set your own from Admin > Settings.
# After that the panel is the source of truth and this value stops mattering.
ADMIN_TOKEN=

# Admin username. Optional, defaults to "admin".
ADMIN_USER=admin

# Signs session tokens. Set this once and leave it alone: it is deliberately
# separate from the password so that changing your password does not sign every
# device out. Falls back to ADMIN_TOKEN if unset.
SESSION_SECRET=

# Your Firebase service account, as one line of JSON. Required.
# Firebase console -> Project settings -> Service accounts -> Generate new private key.
# Keep the "private_key" \n escapes exactly as they are.
FIREBASE_SERVICE_ACCOUNT=

# Instead of FIREBASE_SERVICE_ACCOUNT you may set these three separately:
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
