rules_version = '2';

// All reads and writes go through the Vercel functions using the Firebase Admin
// SDK, which bypasses these rules. Denying everything here means that even if a
// service-account key or a Firebase web config ever leaks, nobody can read or
// modify the database straight from a browser.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
